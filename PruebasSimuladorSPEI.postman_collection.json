              "script": {
                "exec": [
                  "let respuesta = pm.response.json();\r",
                  "if (respuesta.errores && respuesta.errores.length > 0) {\r",
                  "    let codigo = respuesta.errores[0].codigo;\r",
                  "    let mensaje = respuesta.errores[0].mensaje;\r",
                  "\r",
                  "    pm.test(codigo + \": \" + mensaje, function () {\r",
                  "        pm.response.to.have.status(409);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
