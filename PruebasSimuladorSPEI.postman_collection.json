    {
      "name": "IDEMPOTENCIA",
      "item": [
        {
          "name": "A24 — misma clave + mismo body",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera UNA clave y UNA referencia nuevas para todo el escenario (las 3 peticiones las comparten)",
                  "pm.collectionVariables.set('claveIdempotencia', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('referencia', 'IDEM' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Estado inicial RECIBIDO con 1 transicion', () => {",
                  "  pm.expect(j.estado).to.eql('RECIBIDO');",
                  "  pm.expect(j.transiciones.length).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set('operacionId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Clave-Idempotencia",
                "value": "{{claveIdempotencia}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoOperacion\": \"T2T\",\n  \"emisor\": {\n    \"institucion\": \"801\",\n    \"cuenta\": \"801180000118359717\",\n    \"nombre\": \"Ana Ruiz Delgado\"\n  },\n  \"receptor\": {\n    \"institucion\": \"802\",\n    \"cuenta\": \"802180000200030011\",\n    \"nombre\": \"Luis Cano Mora\"\n  },\n  \"importe\": {\n    \"valor\": 1500.5,\n    \"divisa\": \"MXN\"\n  },\n  \"concepto\": \"Pago de servicios\",\n  \"folioNumerico\": 4821,\n  \"referenciaSeguimiento\": \"{{referencia}}\"\n}",
